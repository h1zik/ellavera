# Salin ke .env lalu isi nilainya. Jangan commit .env.

# --- Database (Postgres / Supabase self-hosted) ---
DATABASE_URL=
DIRECT_URL=

# --- Supabase Storage (upload gambar dari admin) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# --- Enkripsi password SMTP yang disimpan lewat Admin Panel ---
# Bebas, minimal 16 karakter. Kalau diisi, password SMTP dari panel admin
# disimpan terenkripsi (AES-256-GCM) di database. Kalau dikosongkan, password
# tersimpan apa adanya dan panel admin menampilkan peringatan.
# PENTING: kalau nilai ini diganti, password lama tidak bisa dibaca lagi —
# tinggal isi ulang passwordnya dari panel admin.
SMTP_CRYPT_KEY=

# --- SMTP: notifikasi email tiap ada submit form ---
# OPSIONAL. Host/port/user/password bisa diisi langsung dari Admin Panel
# (Pengaturan situs > Galeri & form leads > Server pengirim). Env di bawah ini
# hanya dipakai sebagai cadangan kalau blok SMTP di panel admin dikosongkan.
# Alamat PENERIMA selalu diatur dari Admin Panel, bukan dari file ini.
# Kalau dua-duanya kosong: lead tetap tersimpan, emailnya saja yang tidak dikirim.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true untuk port 465 (SSL), false untuk 587 (STARTTLS). Boleh dikosongkan.
SMTP_SECURE=false
SMTP_USER=
# Gmail/Google Workspace: pakai App Password 16 karakter, bukan password login.
SMTP_PASS=
# Alamat pengirim yang tampil di inbox. Kosong = pakai SMTP_USER.
SMTP_FROM="Ellavera Website <no-reply@ellavera.id>"
