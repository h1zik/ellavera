// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DDL (db push / migrate) uses this — Supabase Transaction pooler :6543 hangs; use Direct or Session URI.
  directUrl = env("DIRECT_URL")
}

enum SectionType {
  HERO
  SERVICES
  PROCESS
  WHY_US
  CLIENT_PORTFOLIO
  FACTORY_GALLERY
  TESTIMONIALS
  EDUCATIONAL
  FAQ
  CONTACT
}

enum ContentValueType {
  TEXT
  MARKDOWN
  JSON
  IMAGE_URL
  URL
}

model Section {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  type        SectionType
  enabled     Boolean     @default(true)
  order       Int
  title       String?
  subtitle    String?
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  contents    Content[]

  @@index([enabled, order])
}

model Content {
  id         String           @id @default(cuid())
  sectionId  String
  key        String
  value      String           @db.Text
  valueType  ContentValueType @default(TEXT)
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  section    Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, sortOrder])
  @@unique([sectionId, key, sortOrder])
}

model SiteSettings {
  id               String   @id @default("default")
  siteName         String   @default("Ellavera")
  tagline          String   @default("Maklon kosmetik buat Gen-Z & brand owner — without the drama.")
  /** Teks kecil di atas logo header beranda. Kosongkan untuk menyembunyikan. */
  headerEyebrow    String   @default("Maklon · Gen-Z · Unisex")
  /** Teks kecil di atas judul hero. Kosongkan untuk menyembunyikan. */
  heroKicker       String   @default("Retro · Playful · High-energy")
  brandPurpose     String   @db.Text
  primaryColor     String   @default("#26CCC2")
  secondaryColor   String   @default("#FAE3C7")
  accentColor      String   @default("#FFB76C")
  contactEmail     String?
  contactWhatsapp  String?
  /** Tujuan notifikasi submit form. Boleh >1, pisahkan koma. Kosong = pakai contactEmail. */
  leadNotifyEmail  String?
  /** SMTP dari panel admin. Kalau smtpHost/smtpUser/password kosong → fallback ke env SMTP_*. */
  smtpHost         String?
  smtpPort         Int?
  /** null = otomatis (true kalau port 465). */
  smtpSecure       Boolean?
  smtpUser         String?
  /** Terenkripsi (AES-256-GCM) bila SMTP_CRYPT_KEY diset. Jangan pernah dikirim ke browser. */
  smtpPasswordEnc  String?  @db.Text
  /** Alamat pengirim, mis. "Ellavera <no-reply@ellavera.id>". Kosong = pakai smtpUser. */
  smtpFrom         String?
  /** Alamat kantor / pabrik untuk section kontak */
  locationAddress  String?  @db.Text
  /** Tautan Google Maps atau embed link */
  mapsUrl          String?
  seoTitle         String?
  seoDescription   String?  @db.Text
  seoKeywords      String?
  /** ID Meta (Facebook) Pixel — angka. Jika diisi, pixel + PageView dipasang di semua halaman. */
  metaPixelId      String?
  /** Pixel ID OpenAI (ChatGPT Ads) dari Ads Manager → Conversions. */
  openaiPixelId    String?
  /** Google tag: GA4 (G-…) dan/atau Google Ads (AW-…), pisahkan koma. */
  googleTagIds     String?
  /** Google Ads conversion "send_to" untuk Lead (kirim brief), mis. AW-123456789/AbC-dEfGh. */
  googleAdsLeadSendTo    String?
  /** Google Ads conversion "send_to" untuk Contact (klik WhatsApp). */
  googleAdsContactSendTo String?
  /** Google Tag Manager container (GTM-…) — untuk platform lain tanpa ubah kode. */
  gtmContainerId   String?
  /** TikTok Pixel ID. */
  tiktokPixelId    String?
  heroImageUrl       String?
  /** Logo halaman login admin (URL upload atau path). */
  adminLogoUrl       String?
  /** Favicon situs (URL .ico / .png). */
  faviconUrl         String?
  /** Logo di header halaman utama (menggantikan teks nama situs jika diisi). */
  siteLogoUrl        String?
  /** JSON array: [{ "imageUrl": "https://...", "name": "...", "role": "..." }] */
  talentGalleryJson  String?  @db.Text
  /** JSON array field form leads: id, label, type, required, placeholder, minLength, maxLength */
  leadFormFieldsJson String?  @db.Text
  updatedAt        DateTime @updatedAt
}

model Lead {
  id          String   @id @default(cuid())
  fullName    String
  brandName   String?
  email       String
  phone       String?
  message     String   @db.Text
  /** JSON map jawaban sesuai id field di leadFormFieldsJson saat submit */
  responsesJson String? @db.Text
  source      String   @default("landing-page")
  status      String   @default("new")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}
